{
  "name": "dsh-skill-panel",
  "version": "0.2.2",
  "title": {
    "en": "Skill Panel",
    "zh": "技能面板"
  },
  "description": "技能中心：在导航栏加一页（官方 sidebar.panellist 槽位，order 5，位于「插件」与「自动化任务」之间），列出本机实际暴露的全部技能（六类技能根，不只是 ~/.dsh/skills），说明某技能为何不可见（dropped:* / 根缺失 / 已禁用），并可通过只改入口文件名（SKILL.md → SKILL.md.disabled）单独启停一个技能；项目级技能根只读。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "skills",
    "panellist",
    "skill-panel"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "node test/run-all.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  }
}
